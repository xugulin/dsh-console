# ---- 构建产物 ----------------------------------------------------------
# dist/ 里是 200~400 MB 的便携包 zip，绝不能进仓库（.build-cache 是下载缓存）
dist/
.build-cache/

# ---- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/

# 项目自带虚拟环境（推荐：python3.14 -m venv .venv）
# ⚠️ 不写结尾斜杠：`.venv/` 只忽略目录**内容**，忽略不掉 `.venv` 这个软链本身，
# 而本机的 .venv 正是指向别处的软链（实测被暂存过一次，会把家目录路径带进仓库）。
.venv
venv/

# ---- 本机运行痕迹 ------------------------------------------------------
# 磁盘可写性探针（0 字节）
.disk-probe
# 便携包在源码树里跑起来时会产生的目录
home/
run/
# 控制台自我更新时留下的旧代码备份
app.bak-*/

# ---- 本地预览产物 ------------------------------------------------------
# 发布前用浏览器渲染 README 看版面用的，不进仓库
.github-preview.html

# ---- 生成的启动器条目 --------------------------------------------------
# 由 tools/install-desktop.sh 从 tools/dsh-console.desktop.in 生成，
# 里面是**本机绝对路径**，不该进仓库（模板才是要提交的那个）
/dsh-console.desktop

# ---- 手拍的原始截图 ----------------------------------------------------
# Screenshots/ 是截图的"原料"：**其中控制台页那张的账户余额没有打码**，
# 进仓库等于把余额一起发布。仓库里用的是 docs/screenshots/ 里裁好、打好码的那 5 张。
Screenshots/
